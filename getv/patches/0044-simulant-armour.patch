+
+int mpCombatIsSimulant(struct ChrRecord *chr)
+{
+    int slot;
+    if (!chr || (slot = mpRosterSlotForChr(chr->chrnum)) < 0) return 0;
+    return mpCombatValidActor(&s_lives[slot], slot);
+}
+
+float mpCombatSimulantArmour(struct ChrRecord *chr)
+{
+    int slot;
+    if (!mpCombatIsSimulant(chr)) return 0.0f;
+    slot = mpRosterSlotForChr(chr->chrnum);
+    return s_lives[slot].armour;
+}
+
+int mpCombatPickupSimulantArmour(struct ChrRecord *chr, float normalized_amount)
+{
+    int slot;
+    float pickup = mpSimArmourFromPickup(normalized_amount);
+    if (!mpCombatIsSimulant(chr) || pickup <= 0.0f) return 0;
+    slot = mpRosterSlotForChr(chr->chrnum);
+    if (pickup <= s_lives[slot].armour) return 0;
+    /* Like bondviewAddCurrentPlayerArmor, replace the remaining protection.
+     * Never set chr->damage negative: that would erase existing wounds. */
+    s_lives[slot].armour = pickup;
+    g_playerPlayerData[slot].body_armor_pickups += normalized_amount;
+    return 1;
+}
+
+float mpCombatAbsorbSimulantDamage(struct ChrRecord *chr, float damage)
+{
+    int slot;
+    if (!mpCombatIsSimulant(chr)) return damage;
+    slot = mpRosterSlotForChr(chr->chrnum);
+    float before = s_lives[slot].armour;
+    float toHealth = mpSimAbsorbDamage(&s_lives[slot].armour, damage);
+    if (before > 0.0f && getenv("GETV_SIM_ARMOUR_TRACE"))
+        sysLogPrintf(LOG_NOTE, "sim armour: slot=%d incoming=%.2f absorbed=%.2f remaining=%.2f healthDamage=%.2f",
+                     slot, (double)damage, (double)(damage - toHealth),
+                     (double)s_lives[slot].armour, (double)toHealth);
+    return toHealth;
 }
 
