+/* Match the human pickup rules: only a live stage vest offering more armour
+ * than the current pool is useful. Respawning objects remain stage-owned. */
+static int simProbeUsableArmour(PropRecord *prop, float current)
+{
+    if (!prop || !(prop->flags & PROPFLAG_ENABLED) ||
+        prop->type != PROP_TYPE_OBJ || prop->parent || prop->timetoregen > 0 ||
+        !prop->stan || !prop->obj || prop->obj->prop != prop ||
+        prop->obj->type != PROPDEF_ARMOUR ||
+        !(prop->obj->state & PROPSTATE_RESPAWN) ||
+        (prop->obj->runtime_bitflags & RUNTIMEBITFLAG_00000800) ||
+        (prop->obj->flags & (PROPFLAG_UNCOLLECTABLE | PROPFLAG_ASSIGNEDTOCHR |
+                             PROPFLAG_INSIDEANOTHEROBJ))) return 0;
+    return mpSimArmourFromPickup(((BodyArmourRecord *)prop->obj)->amount) > current;
+}
+
+static int simProbeSeekArmour(ChrRecord *chr, unsigned polls, SimProbeRoute *route)
+{
+    PropRecord *nearest = NULL, *locked = NULL;
+    float current = mpCombatSimulantArmour(chr);
+    float best = 0.0f, lockedScore = 0.0f;
+    int seen = 0;
+    for (PropRecord *prop = g_ActivePropsHead; prop && seen++ < MAX_PROPS;
+         prop = prop->next) {
+        if (!simProbeUsableArmour(prop, current) ||
+            (prop == route->blockedArmour && polls < route->armourBlockedUntil))
+            continue;
+        float dx = prop->pos.x - chr->prop->pos.x;
+        float dy = prop->pos.y - chr->prop->pos.y;
+        float dz = prop->pos.z - chr->prop->pos.z;
+        float distance = sqrtf(dx * dx + dz * dz + 16.0f * dy * dy);
+        float score = mpSimArmourPickupScore(current,
+            mpSimArmourFromPickup(((BodyArmourRecord *)prop->obj)->amount), distance);
+        if (prop == route->armourTarget) { locked = prop; lockedScore = score; }
+        if (score > best) { best = score; nearest = prop; }
+    }
+    if (locked && lockedScore >= best * 0.85f) nearest = locked;
+    /* Ignore a sliver of protection across the map; a full nearby vest
+     * easily clears this threshold. */
+    if (best < 35.0f) nearest = NULL;
+    if (!nearest) {
+        if (route->armourTarget) {
+            route->goal = -1;
+            route->retryAfter = polls;
+        }
+        route->armourTarget = NULL;
+        return 0;
+    }
+    float dx = nearest->pos.x - chr->prop->pos.x;
+    float dy = nearest->pos.y - chr->prop->pos.y;
+    float dz = nearest->pos.z - chr->prop->pos.z;
+    if (dx * dx + dz * dz < 135.0f * 135.0f &&
+        dy * dy < 150.0f * 150.0f) {
+        StandTile *tile = chr->prop->stan;
+        chrSetMoving(chr, 0);
+        int reachable = stanTestLineUnobstructed(&tile, chr->prop->pos.x,
+            chr->prop->pos.z, nearest->pos.x, nearest->pos.z,
+            CDTYPE_OBJS | CDTYPE_DOORS | CDTYPE_PATHBLOCKER | CDTYPE_AIOPAQUE,
+            chr->chrheight - 20.0f, chr->chrheight - 20.0f, 0.0f, 1.0f);
+        chrSetMoving(chr, 1);
+        if (reachable && tile == nearest->stan &&
+            mpCombatPickupSimulantArmour(chr,
+                ((BodyArmourRecord *)nearest->obj)->amount)) {
+            int pad = nearest->obj->pad;
+            propExecuteTickOperation(nearest, TICKOP_FREE);
+            sysLogPrintf(LOG_NOTE, "sim probe: picked up armour at pad %d (%.2f); world pickup respawning",
+                         pad, (double)(mpCombatSimulantArmour(chr) / MP_SIM_ACTOR_HEALTH));
+            route->armourTarget = NULL;
+            route->goal = -1;
+            route->retryAfter = polls + 30;
+            return 1;
+        }
+        /* A close vest behind a wall is not a collectible vest. Give the
+         * route solver another goal instead of camping beside that wall. */
+        route->blockedArmour = nearest;
+        route->armourBlockedUntil = polls + 360;
+        route->armourTarget = NULL;
+        route->retryAfter = polls;
+        return 0;
+    }
+    if (route->armourTarget == nearest &&
+        polls - route->sampleAt >= SIM_ROUTE_STALL_POLLS) {
+        float movedX = chr->prop->pos.x - route->sampleX;
+        float movedZ = chr->prop->pos.z - route->sampleZ;
+        if (chr->actiontype == ACT_GOPOS &&
+            movedX * movedX + movedZ * movedZ < 64.0f * 64.0f &&
+            dx * dx + dz * dz > 180.0f * 180.0f) {
+            route->blockedArmour = nearest;
+            route->armourBlockedUntil = polls + 360;
+            route->armourTarget = NULL;
+            route->retryAfter = polls + 120;
+            route->sampleAt = polls;
+            return 0;
+        }
+        route->sampleAt = polls;
+        route->sampleX = chr->prop->pos.x;
+        route->sampleZ = chr->prop->pos.z;
+    }
+    if (polls >= route->retryAfter &&
+        (route->armourTarget != nearest || chr->actiontype != ACT_GOPOS)) {
+        int pad = nearest->obj->pad;
+        int ok = chrGoToPad(chr, pad, SPEED_SPRINT);
+        sysLogPrintf(LOG_NOTE, "sim probe: route to armour at pad %d: %s",
+                     pad, ok ? "running" : "unreachable");
+        route->retryAfter = polls + SIM_ROUTE_REPLAN_POLLS;
+        if (ok) {
+            route->armourTarget = nearest;
+            route->goal = -1;
+            route->sampleAt = polls;
+            route->sampleX = chr->prop->pos.x;
+            route->sampleZ = chr->prop->pos.z;
+        } else {
+            route->blockedArmour = nearest;
+            route->armourBlockedUntil = polls + 360;
+            route->armourTarget = NULL;
+            return 0;
+        }
+    }
+    return 1;
+}
