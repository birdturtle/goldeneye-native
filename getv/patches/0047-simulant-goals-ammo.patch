+static int simProbeSeekAmmo(ChrRecord *chr, unsigned polls, SimProbeRoute *route,
+                            PropRecord *nearest)
+{
+    int pad = nearest->obj->pad;
+    float dx = nearest->pos.x - chr->prop->pos.x;
+    float dy = nearest->pos.y - chr->prop->pos.y;
+    float dz = nearest->pos.z - chr->prop->pos.z;
+    if (dx * dx + dz * dz < 135.0f * 135.0f &&
+        dy * dy < 150.0f * 150.0f) {
+        StandTile *tile = chr->prop->stan;
+        chrSetMoving(chr, 0);
+        int reachable = stanTestLineUnobstructed(&tile, chr->prop->pos.x,
+            chr->prop->pos.z, nearest->pos.x, nearest->pos.z,
+            CDTYPE_OBJS | CDTYPE_DOORS | CDTYPE_PATHBLOCKER | CDTYPE_AIOPAQUE,
+            chr->chrheight - 20.0f, chr->chrheight - 20.0f, 0.0f, 1.0f);
+        chrSetMoving(chr, 1);
+        if (reachable && tile == nearest->stan) {
+            int knives = simProbeAmmoInCrate(nearest, AMMO_KNIFE);
+            int mines = simProbeAmmoInCrate(nearest, AMMO_REMOTEMINE);
+            int knifeCap = get_max_ammo_for_type(AMMO_KNIFE);
+            int mineCap = get_max_ammo_for_type(AMMO_REMOTEMINE);
+            int oldKnives = route->knifeAmmo, oldMines = route->remoteAmmo;
+            if (knives > 0 && knifeCap > oldKnives) {
+                route->knifeAmmo += knives;
+                if (route->knifeAmmo > knifeCap) route->knifeAmmo = knifeCap;
+            }
+            if (mines > 0 && mineCap > oldMines) {
+                route->remoteAmmo += mines;
+                if (route->remoteAmmo > mineCap) route->remoteAmmo = mineCap;
+            }
+            if (route->knifeAmmo != oldKnives || route->remoteAmmo != oldMines) {
+                propExecuteTickOperation(nearest, TICKOP_FREE);
+                sysLogPrintf(LOG_NOTE, "sim probe: picked up ammo at pad %d; knives=%d remote mines=%d",
+                             pad, route->knifeAmmo, route->remoteAmmo);
+                route->ammoTarget = NULL;
+                route->goal = -1;
+                route->retryAfter = polls + 30;
+                return 1;
+            }
+        }
+        route->blockedAmmo = nearest;
+        route->ammoBlockedUntil = polls + 360;
+        route->ammoTarget = NULL;
+        route->retryAfter = polls;
+        return 0;
+    }
+    if (route->ammoTarget == nearest &&
+        polls - route->sampleAt >= SIM_ROUTE_STALL_POLLS) {
+        float movedX = chr->prop->pos.x - route->sampleX;
+        float movedZ = chr->prop->pos.z - route->sampleZ;
+        if (chr->actiontype == ACT_GOPOS &&
+            movedX * movedX + movedZ * movedZ < 64.0f * 64.0f &&
+            dx * dx + dz * dz > 180.0f * 180.0f) {
+            route->blockedAmmo = nearest;
+            route->ammoBlockedUntil = polls + 360;
+            route->ammoTarget = NULL;
+            route->retryAfter = polls + 120;
+            return 0;
+        }
+        route->sampleAt = polls;
+        route->sampleX = chr->prop->pos.x;
+        route->sampleZ = chr->prop->pos.z;
+    }
+    if (polls >= route->retryAfter &&
+        (route->ammoTarget != nearest || chr->actiontype != ACT_GOPOS)) {
+        int ok = chrGoToPad(chr, pad, SPEED_SPRINT);
+        sysLogPrintf(LOG_NOTE, "sim probe: route to ammo at pad %d: %s",
+                     pad, ok ? "running" : "unreachable");
+        route->retryAfter = polls + SIM_ROUTE_REPLAN_POLLS;
+        if (ok) {
+            route->ammoTarget = nearest;
+            route->goal = -1;
+            route->sampleAt = polls;
+            route->sampleX = chr->prop->pos.x;
+            route->sampleZ = chr->prop->pos.z;
+        } else {
+            route->blockedAmmo = nearest;
+            route->ammoBlockedUntil = polls + 360;
+            route->ammoTarget = NULL;
+        }
+    }
+    return 1;
+}
