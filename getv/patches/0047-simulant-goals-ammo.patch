+/* PD's bot_find_pickup scans weapon, ammo and shield props independently of
+ * the equipped hand (n64decomp/perfect_dark at
+ * 169ed48bdcbfb3b568b028bd5bebb27680073514, src/game/bot.c).
+ * GoldenEye's selected MP set produces multi-ammo crates even for entries
+ * whose weapon prop has allowpickup=0. Only offer attacks we can execute. */
+static int simProbeAmmoInCrate(PropRecord *prop, int ammotype)
+{
+    struct s_mp_weapon_set *set = getPtrMPWeaponSetData();
+    if (!prop || !(prop->flags & PROPFLAG_ENABLED) || prop->parent ||
+        prop->timetoregen > 0 || !prop->stan || !prop->obj ||
+        prop->obj->prop != prop || prop->obj->type != PROPDEF_AMMO ||
+        !(prop->obj->state & PROPSTATE_RESPAWN) ||
+        (prop->obj->runtime_bitflags & RUNTIMEBITFLAG_00000800) ||
+        (prop->obj->flags & (PROPFLAG_UNCOLLECTABLE | PROPFLAG_INSIDEANOTHEROBJ)))
+        return 0;
+    int allowed = 0;
+    for (int i = 0; i < 8; ++i)
+        if (set[i].ammotype == ammotype &&
+            ((ammotype == AMMO_KNIFE && set[i].itemID == ITEM_THROWKNIFE) ||
+             (ammotype == AMMO_REMOTEMINE && set[i].itemID == ITEM_REMOTEMINE)))
+            allowed = 1;
+    if (!allowed || ammotype <= AMMO_NONE || ammotype > AMMOTYPE_GLOBAL_MAX)
+        return 0;
+    return ((MultiAmmoCrateRecord *)prop->obj)->slots[ammotype - 1].quantity;
+}
