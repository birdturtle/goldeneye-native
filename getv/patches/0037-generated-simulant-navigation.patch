+int simulantProbeGeneratedRequested(void)
+{
+    const char *mode = getenv("GETV_SIM_NAV");
+    return mode && strcmp(mode, "generated") == 0;
+}
+
+int simulantProbeGeneratedNavActive(void)
+{
+    return s_generatedWaypoints && g_CurrentSetup.pathwaypoints == s_generatedWaypoints &&
+           g_CurrentSetup.waypointgroups == s_generatedGroups;
+}
+
+/* The route solver's result includes its NULL terminator. On an incomplete
+ * route, the engine replans when it advances past the fourth waypoint. */
+int simulantProbeGeneratedRoute(waypoint *from, waypoint *to,
+                                waypoint **out, int capacity)
+{
+    int ids[5], count, fromIndex = -1, toIndex = -1, i, j;
+    if (!out || capacity < 1) return 0;
+    out[0] = NULL;
+    if (!simulantProbeGeneratedNavActive() || !from || !to) return 1;
+    for (i = 0; i < s_generatedGraph.node_count; ++i) {
+        if (from == &s_generatedWaypoints[i]) fromIndex = i;
+        if (to == &s_generatedWaypoints[i]) toIndex = i;
+    }
+    if (fromIndex < 0 || toIndex < 0) return 1;
+    if (capacity > 6) capacity = 6;
+    count = mpNavGraphRoute(&s_generatedGraph, from->padID, to->padID,
+                            ids, capacity - 1);
+    for (i = 0; i < count; ++i) {
+        for (j = 0; j < s_generatedGraph.node_count; ++j)
+            if (s_generatedWaypoints[j].padID == ids[i]) break;
+        if (j == s_generatedGraph.node_count) break;
+        out[i] = &s_generatedWaypoints[j];
+    }
+    out[i++] = NULL;
+    /* plot_course_for_actor copies all six slots even for a short route. */
+    for (j = i; j < capacity; ++j) out[j] = NULL;
+    return i;
+}
 
