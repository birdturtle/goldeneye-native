+/* STAN's straight tile walk checks that both pad centres share a traversable
+ * segment. Bidirectional testing is performed by mpNavGraphBuild. Dynamic
+ * doors, actor radius, and steps are left to the normal movement collision. */
+static int simProbeDirectWalk(const MpNavAnchor *from, const MpNavAnchor *to,
+                              void *context)
+{
+    PadRecord *pads = context;
+    StandTile *tile = pads[from->pad_id].stan;
+    if (!tile || !pads[to->pad_id].stan || fabsf(from->y - to->y) > 160.0f)
+        return 0;
+    return walkTilesBetweenPoints_NoCallback(&tile, from->x, from->z,
+                                              to->x, to->z) &&
+           tile == pads[to->pad_id].stan;
+}
+
+static int simProbeInstallGeneratedNav(int stage)
+{
+    MpNavAnchor *anchors = NULL;
+    int pads = 0, i, j, offset = 0, n;
+    if (simulantProbeGeneratedNavActive()) return 1;
+    if (!g_CurrentSetup.pads || !g_CurrentSetup.pathwaypoints ||
+        !g_CurrentSetup.waypointgroups ||
+        g_CurrentSetup.pathwaypoints[0].padID >= 0 ||
+        g_CurrentSetup.waypointgroups[0].neighbours ||
+        g_CurrentSetup.pads == s_generatedFailedPads) return 0;
+    while (pads < 1024 && g_CurrentSetup.pads[pads].plink) ++pads;
+    if (pads >= 1024 || pads < 2) goto failed;
+    anchors = malloc((size_t)pads * sizeof(*anchors));
+    if (!anchors) goto failed;
+    for (i = 0; i < pads; ++i) {
+        PadRecord *pad = &g_CurrentSetup.pads[i];
+        anchors[i] = (MpNavAnchor){i, pad->pos.x, pad->pos.y, pad->pos.z,
+                                   pad->stan != NULL};
+    }
+    if (!mpNavGraphBuild(&s_generatedGraph, stage, anchors, pads, 24,
+                         simProbeDirectWalk, g_CurrentSetup.pads)) goto failed;
+    free(anchors);
+    anchors = NULL;
+    n = s_generatedGraph.node_count;
+    sysLogPrintf(LOG_NOTE,
+                 "sim nav: stage=%d pads=%d nodes=%d edges=%d components=%d largest=%d isolated=%d hops=%d",
+                 stage, pads, n, s_generatedGraph.edge_count,
+                 s_generatedGraph.component_count, s_generatedGraph.largest_component,
+                 s_generatedGraph.isolated_nodes, s_generatedGraph.max_route_hops);
+    if (n < 2 || s_generatedGraph.largest_component < 2) goto failed;
+    s_generatedWaypoints = calloc((size_t)n + 1, sizeof(*s_generatedWaypoints));
+    s_generatedGroups = calloc(2, sizeof(*s_generatedGroups));
+    s_generatedMembers = malloc(((size_t)n + 1) * sizeof(*s_generatedMembers));
+    s_generatedNeighbours = malloc(((size_t)n + 2 * s_generatedGraph.edge_count) *
+                                    sizeof(*s_generatedNeighbours));
+    if (!s_generatedWaypoints || !s_generatedGroups || !s_generatedMembers ||
+        !s_generatedNeighbours) goto failed;
+    for (i = 0; i < n; ++i) {
+        waypoint *point = &s_generatedWaypoints[i];
+        point->padID = s_generatedGraph.nodes[i].pad_id;
+        point->groupNum = 0;
+        point->dist = -1;
+        point->neighbours = &s_generatedNeighbours[offset];
+        for (j = 0; j < n; ++j)
+            if (s_generatedGraph.edges[(size_t)i * n + j])
+                s_generatedNeighbours[offset++] = j;
+        s_generatedNeighbours[offset++] = -1;
+        s_generatedMembers[i] = i;
+    }
+    s_generatedWaypoints[n].padID = -1;
+    s_generatedMembers[n] = -1;
+    s_generatedGroups[0].neighbours = s_generatedGroupNeighbours;
+    s_generatedGroups[0].waypoints = s_generatedMembers;
+    s_generatedGroups[1].neighbours = NULL;
+    s_navWaypoints = s_generatedWaypoints;
+    s_navCount = n;
+    s_originalWaypoints = g_CurrentSetup.pathwaypoints;
+    s_originalGroups = g_CurrentSetup.waypointgroups;
+    g_CurrentSetup.pathwaypoints = s_generatedWaypoints;
+    g_CurrentSetup.waypointgroups = s_generatedGroups;
+    return 1;
+failed:
+    free(anchors);
+    sysLogPrintf(LOG_NOTE, "sim nav: stage %d graph unavailable; navigation disabled", stage);
+    s_generatedFailedPads = g_CurrentSetup.pads;
+    free(s_generatedWaypoints);
+    free(s_generatedGroups);
+    free(s_generatedMembers);
+    free(s_generatedNeighbours);
+    s_generatedWaypoints = NULL;
+    s_generatedGroups = NULL;
+    s_generatedMembers = NULL;
+    s_generatedNeighbours = NULL;
+    mpNavGraphClear(&s_generatedGraph);
+    return 0;
+}
