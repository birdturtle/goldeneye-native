+/* Temple has no authored MP waypoints. Its setup pads mark weapons, spawns and
+ * other objects, leaving gaps at turns. Add points from the live STAN floor
+ * while retaining the original pad IDs. The copy has the original terminator
+ * at the same index, so setup code that scans named pads sees the same list. */
+static int simProbeStanPadCount(void)
+{
+    StandTile *tile;
+    int count = 0, visited = 0;
+    if (!standTileStart || !stanTileEnd) return 0;
+    tile = (StandTile *)((u8 *)standTileStart + 0x80);
+    if ((uintptr_t)tile > (uintptr_t)stanTileEnd) return 0;
+    while ((uintptr_t)tile <= (uintptr_t)stanTileEnd) {
+        int points = GE_NIB(tile->tail.half, 12);
+        coord3d center;
+        if (++visited > SIM_STAN_NAV_LIMIT || points < 3 || points > 10 ||
+            !list_of_tilesizes[points]) return 0;
+        if (!stanTileHasZeroArea(tile)) {
+            getTileMidPoint(tile, &center);
+            if (stanTestPointWithinTileBoundsMaybe(tile, center.x, center.z))
+                ++count;
+        }
+        tile = (StandTile *)((u8 *)tile + list_of_tilesizes[points]);
+    }
+    return count;
+}
+
+static int simProbeMakeStanPads(int originalCount)
+{
+    StandTile *tile;
+    int count = simProbeStanPadCount(), written = 0;
+    if (!count) return 0;
+    s_generatedPads = calloc((size_t)originalCount + 1 + count,
+                             sizeof(*s_generatedPads));
+    if (!s_generatedPads) return 0;
+    memcpy(s_generatedPads, g_CurrentSetup.pads,
+           ((size_t)originalCount + 1) * sizeof(*s_generatedPads));
+    for (tile = (StandTile *)((u8 *)standTileStart + 0x80);
+         (uintptr_t)tile <= (uintptr_t)stanTileEnd;
+         tile = (StandTile *)((u8 *)tile + list_of_tilesizes[GE_NIB(tile->tail.half, 12)])) {
+        coord3d center;
+        if (stanTileHasZeroArea(tile)) continue;
+        getTileMidPoint(tile, &center);
+        if (!stanTestPointWithinTileBoundsMaybe(tile, center.x, center.z)) continue;
+        PadRecord *pad = &s_generatedPads[originalCount + 1 + written++];
+        pad->pos = center;
+        pad->up.y = 1.0f;
+        pad->look.z = 1.0f;
+        pad->stan = tile;
+    }
+    if (written != count) {
+        free(s_generatedPads);
+        s_generatedPads = NULL;
+        return 0;
+    }
+    return count;
+}
