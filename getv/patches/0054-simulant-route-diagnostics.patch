+static int simProbeNavTraceEnabled(void)
+{
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char *value = getenv("GETV_SIM_NAV_TRACE");
+        enabled = value && value[0] == '1' && value[1] == '\0';
+    }
+    return enabled;
+}
+
+/* Report the route the actor received, not merely that chrGoToPad accepted it.
+ * Native movement can still fail on a wall, door, or character-width check. */
+static void simProbeTraceRoute(ChrRecord *chr, unsigned polls, const char *reason)
+{
+    char path[96];
+    int used = 0;
+    if (!simProbeNavTraceEnabled() || chr->actiontype != ACT_GOPOS) return;
+    path[0] = '\0';
+    for (int i = 0; i < MAX_CHRWAYPOINTS; ++i) {
+        waypoint *point = chr->act_gopos.waypoints[i];
+        int added = snprintf(path + used, sizeof(path) - used,
+                             "%s%d", i ? "," : "", point ? point->padID : -1);
+        if (added < 0 || added >= (int)sizeof(path) - used) break;
+        used += added;
+    }
+    sysLogPrintf(LOG_NOTE,
+        "sim nav trace: poll=%u route=%s start=(%.0f %.0f %.0f) target=(%.0f %.0f %.0f) pads=%s",
+        polls, reason, chr->prop->pos.x, chr->prop->pos.y, chr->prop->pos.z,
+        chr->act_gopos.targetpos.x, chr->act_gopos.targetpos.y,
+        chr->act_gopos.targetpos.z, path);
+}
+
+static void simProbeTraceMovement(ChrRecord *chr, unsigned polls,
+                                   const SimProbeRoute *route, int force)
+{
+    int index = -1, padid = -1, mode = -1;
+    float dx = 0.0f, dz = 0.0f, done = 0.0f, total = 0.0f;
+    if (!simProbeNavTraceEnabled() || (!force && polls % 30 != 0) ||
+        !chr->prop) return;
+    if (chr->actiontype == ACT_GOPOS) {
+        coord3d *next = &chr->act_gopos.targetpos;
+        index = chr->act_gopos.curindex;
+        if (index >= 0 && index < MAX_CHRWAYPOINTS &&
+            chr->act_gopos.waypoints[index]) {
+            padid = chr->act_gopos.waypoints[index]->padID;
+            next = &g_CurrentSetup.pads[padid].pos;
+        }
+        dx = next->x - chr->prop->pos.x;
+        dz = next->z - chr->prop->pos.z;
+        mode = chr->act_gopos.waydata.mode;
+        done = chr->act_gopos.waydata.segdistdone;
+        total = chr->act_gopos.waydata.segdisttotal;
+    }
+    sysLogPrintf(LOG_NOTE,
+        "sim nav trace: poll=%u goal=%d player=%d action=%d pos=(%.0f %.0f %.0f) index=%d pad=%d nextdist=%.0f mode=%d seg=%.0f/%.0f lastmove=%d",
+        polls, route->goalKind, route->targetPlayer, chr->actiontype,
+        chr->prop->pos.x, chr->prop->pos.y, chr->prop->pos.z,
+        index, padid, sqrtf(dx*dx + dz*dz), mode, done, total,
+        g_GlobalTimer - chr->lastmoveok60);
+}
+
+void simulantProbeTraceDoor(ChrRecord *chr, PropRecord *door)
+{
+    if (!simProbeNavTraceEnabled() || !chr || chr->chrnum != SIM_PROBE_CHRNUM ||
+        !chr->prop || !door) return;
+    sysLogPrintf(LOG_NOTE,
+        "sim nav trace: poll=%u door=(%.0f %.0f %.0f) actor=(%.0f %.0f %.0f) index=%d",
+        s_probe.polls, door->pos.x, door->pos.y, door->pos.z,
+        chr->prop->pos.x, chr->prop->pos.y, chr->prop->pos.z,
+        chr->actiontype == ACT_GOPOS ? chr->act_gopos.curindex : -1);
+}
 
