+void mpCombatDamageHumanRef(MpRosterRef owner, int victim_human, float damage,
+                            float dx, float dz)
+{
+    /* A projectile from a previous life must not be credited to the actor
+     * occupying the same roster slot after respawn. */
+    if (mpRosterResolve(owner) == owner.slot)
+        mpCombatDamageHuman(owner.slot, victim_human, damage, dx, dz);
+}
+
+int mpCombatSimKnifeHit(const void *knife_obj, int victim_human, int hitpart,
+                        float dx, float dz)
+{
+    MpRosterRef owner;
+    float damage;
+    if (!mpSimEffectOwned(knife_obj, MP_SIM_EFFECT_KNIFE)) return 0;
+    owner = mpSimEffectOwner(knife_obj, MP_SIM_EFFECT_KNIFE);
+    damage = 0.125f * gunItemGetDestructionAmount(ITEM_THROWKNIFE);
+    if (hitpart == HIT_HEAD) damage *= 4.0f;
+    else if (hitpart == HIT_CHEST) damage *= 2.0f;
+    else if (hitpart == HIT_GENERALHALF) damage *= 0.5f;
+    else if (hitpart == HIT_GUN || hitpart == HIT_HAT) damage = 0.0f;
+    if (damage > 0.0f) {
+        float length = sqrtf(dx * dx + dz * dz);
+        if (length > 0.0f) { dx /= length; dz /= length; }
+        mpCombatDamageHumanRef(owner, victim_human, damage, dx, dz);
+    }
+    return 1;
+}
