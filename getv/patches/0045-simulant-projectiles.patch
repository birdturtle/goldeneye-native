+/* Spawn a real native projectile from the character's hand. The object's
+ * packed OWNER bits remain zero but never authorize damage; the sidecar owns
+ * every knife impact and blast from this object. */
+static ObjectRecord *simProbeThrow(ChrRecord *chr, int item,
+                                   const struct player *target)
+{
+    float dx = target->prop->pos.x - chr->prop->pos.x;
+    float dz = target->prop->pos.z - chr->prop->pos.z;
+    float distance = sqrtf(dx * dx + dz * dz);
+    float nx, nz;
+    coord3d pos, velocity;
+    Mtxf orientation, spin;
+    ObjectRecord *obj;
+    MpRosterRef owner = mpRosterRefForSlot(mpRosterSlotForChr(chr->chrnum));
+    MpSimEffectKind kind = item == ITEM_THROWKNIFE ? MP_SIM_EFFECT_KNIFE :
+                                                   MP_SIM_EFFECT_REMOTE_MINE;
+    if (distance < 1.0f || mpRosterResolve(owner) != owner.slot) return NULL;
+    nx = dx / distance;
+    nz = dz / distance;
+    pos.x = chr->prop->pos.x + 40.0f * nx;
+    pos.y = chr->prop->pos.y + 55.0f;
+    pos.z = chr->prop->pos.z + 40.0f * nz;
+    velocity.x = 16.666666f * nx;
+    velocity.z = 16.666666f * nz;
+    velocity.y = 5.0f + (target->prop->pos.y - pos.y) * 16.666666f / distance;
+    matrix_4x4_set_position_and_rotation_around_y(pos.f,
+        atan2f(nx, nz), &orientation);
+    matrix_4x4_set_identity(&spin);
+    obj = create_new_item_instance_of_model(
+        item == ITEM_THROWKNIFE ? PROP_CHRKNIFE : PROP_CHRREMOTEMINE, item);
+    if (!obj) return NULL;
+    obj->runtime_bitflags &= ~RUNTIMEBITFLAG_OWNER;
+#ifdef REFRESH_PAL
+    if (kind == MP_SIM_EFFECT_REMOTE_MINE) ((WeaponObjRecord *)obj)->timer = 150;
+#else
+    if (kind == MP_SIM_EFFECT_REMOTE_MINE) ((WeaponObjRecord *)obj)->timer = 180;
+#endif
+    gunInitProjectileObject(obj, &pos, chr->prop->stan, &orientation,
+                            &velocity, &spin, chr->prop);
+    if (!(obj->runtime_bitflags & RUNTIMEBITFLAG_HASPROJECTILE) ||
+        !mpSimEffectTrack(obj, kind, owner)) {
+        objFreePermanently(obj, TRUE);
+        return NULL;
+    }
+    obj->projectile->flags |= 2;
+    obj->projectile->unk8C = 0.1f;
+#ifdef REFRESH_PAL
+    obj->projectile->refreshrate = 50;
+#else
+    obj->projectile->refreshrate = 60;
+#endif
+    if (kind == MP_SIM_EFFECT_KNIFE) {
+        obj->runtime_bitflags |= RUNTIMEBITFLAG_THROWING_KNIFE_RELATED;
+        objUpdateThrowKnifeSound(obj);
+    } else {
+        ALSoundState *sound = sndPlaySfx((struct ALBankAlt_s *)g_musicSfxBufferPtr,
+                                         GRENADE_THROW_SFX, NULL);
+        if (sound) chrobjSndCreatePostEventDefault(sound, &pos);
+    }
+    chrSetWeaponFlag4(chr, GUNRIGHT);
+    sysLogPrintf(LOG_NOTE, "sim probe: threw %s from slot %d",
+                 kind == MP_SIM_EFFECT_KNIFE ? "knife" : "remote mine", owner.slot);
+    return obj;
+}
+
+static void simProbeRemoteDetonate(ChrRecord *chr, SimProbeRoute *route)
+{
+    ObjectRecord *mine = route->mineObj;
+    if (!mine) return;
+    if (!mpSimEffectOwned(mine, MP_SIM_EFFECT_REMOTE_MINE)) {
+        route->mineObj = NULL;
+        return;
+    }
+    if (mpRosterResolve(mpSimEffectOwner(mine, MP_SIM_EFFECT_REMOTE_MINE)) < 0 ||
+        !mine->prop || ((WeaponObjRecord *)mine)->timer != 1 ||
+        (mine->runtime_bitflags & RUNTIMEBITFLAG_HASPROJECTILE)) return;
+    float bx = chr->prop->pos.x - mine->runtime_pos.x;
+    float bz = chr->prop->pos.z - mine->runtime_pos.z;
+    if (bx * bx + bz * bz < 330.0f * 330.0f) return;
+    for (int i = 0; i < getPlayerCount() && i < 4; ++i) {
+        const struct player *player = g_playerPointers[i];
+        if (!player || !player->prop || player->bonddead) continue;
+        float dx = player->prop->pos.x - mine->runtime_pos.x;
+        float dy = player->prop->pos.y - mine->runtime_pos.y;
+        float dz = player->prop->pos.z - mine->runtime_pos.z;
+        if (dx * dx + dz * dz < 240.0f * 240.0f &&
+            dy * dy < 120.0f * 120.0f) {
+            ((WeaponObjRecord *)mine)->timer = 0; /* native weapon tick creates the blast */
+            route->mineObj = NULL;
+            sysLogPrintf(LOG_NOTE, "sim probe: detonated remote mine near player %d", i + 1);
+            return;
+        }
+    }
 }
 
