+/* The policy is also used by pickup and combat. Unsupported weapons must
+ * never become a pickup goal until their action path is implemented. */
+static MpSimWeaponKind simProbeWeaponKind(int item)
+{
+    switch (item) {
+    case ITEM_WPPK: case ITEM_WPPKSIL: case ITEM_TT33:
+    case ITEM_SILVERWPPK: case ITEM_GOLDWPPK: case ITEM_GOLDENGUN:
+        return MP_SIM_PISTOL;
+    case ITEM_SKORPION: case ITEM_UZI: case ITEM_MP5K: case ITEM_MP5KSIL:
+    case ITEM_SPECTRE: case ITEM_FNP90: return MP_SIM_AUTOMATIC;
+    case ITEM_SHOTGUN: case ITEM_AUTOSHOT: return MP_SIM_SHOTGUN;
+    case ITEM_AK47: case ITEM_M16: return MP_SIM_RIFLE;
+    case ITEM_SNIPERRIFLE: return MP_SIM_SNIPER;
+    case ITEM_RUGER: return MP_SIM_MAGNUM;
+    case ITEM_LASER: return MP_SIM_LASER;
+    case ITEM_KNIFE: case ITEM_THROWKNIFE: return MP_SIM_KNIFE;
+    case ITEM_GRENADE: return MP_SIM_GRENADE;
+    case ITEM_TIMEDMINE: case ITEM_PROXIMITYMINE: case ITEM_REMOTEMINE:
+        return MP_SIM_MINE;
+    case ITEM_GRENADELAUNCH: case ITEM_ROCKETLAUNCH: return MP_SIM_LAUNCHER;
+    default: return MP_SIM_UNARMED;
+    }
+}
