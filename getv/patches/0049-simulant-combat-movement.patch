-                      (route->knifeAmmo > 0 || route->remoteAmmo > 0)))) {
-                    if (!route->engaging)
-                        sysLogPrintf(LOG_NOTE, "sim probe: close engagement; facing player");
+                      (route->knifeAmmo > 0 || route->remoteAmmo > 0))) &&
