+/* PD's botcmd distance mode chooses advance, back up or hold; this port turns
+ * hold into lateral movement. The adapter ranks live stage waypoints and lets
+ * GoldenEye validate the actual route, collision and doors through chrGoToPad.
+ * n64decomp/perfect_dark @ 169ed48bdcbfb3b568b028bd5bebb27680073514,
+ * src/game/botcmd.c (MIT). No waypoint coordinates are shipped here. */
+static int simProbeManeuver(ChrRecord *chr, unsigned polls,
+                            SimProbeRoute *route, const struct player *target)
+{
+    float tx = target->prop->pos.x - chr->prop->pos.x;
+    float tz = target->prop->pos.z - chr->prop->pos.z;
+    float range = sqrtf(tx * tx + tz * tz);
+    MpSimCombatMode mode = mpSimCombatDistanceMode(
+        range, route->combatIdealRange, 1,
+        route->combatIdealRange == 145.0f, route->combatMode);
+    if (mode != route->combatMode || !route->engaging) {
+        route->combatMode = mode;
+        route->combatGoal = -1;
+        route->combatRetryAfter = polls;
+    }
+    if (mode == MP_SIM_COMBAT_ADVANCE) return 0; /* normal pursuit route */
+    if (chr->actiontype == ACT_STAND) {
+        float desired = atan2f(tx, tz);
+        if (desired < 0.0f) desired += M_TAU_F;
+        chr->act_stand.face_entitytype = 0x10;
+        chr->act_stand.face_entityid =
+            (int)(desired * (M_U16_MAX_VALUE_F / M_TAU_F));
+    }
+    if (polls < route->combatRetryAfter && chr->actiontype == ACT_GOPOS)
+        return 1;
+    if (polls < route->combatRetryAfter) return 1;
+    route->combatRetryAfter = polls + SIM_ROUTE_REPLAN_POLLS;
+
+    waypoint *start = chrlvStanPathRelated(&chr->prop->pos, chr->prop->stan);
+    int bestGoal = -1;
+    float best = 1.0e30f;
+    if (start) for (int i = 0; i < s_navCount; ++i) {
+        waypoint *point = &s_navWaypoints[i];
+        if (point == start || (i == route->blockedGoal && polls < route->blockedUntil) ||
+            (simulantProbeGeneratedNavActive() &&
+             !mpNavGraphReachable(&s_generatedGraph, start->padID, point->padID)))
+            continue;
+        PadRecord *pad = &g_CurrentSetup.pads[point->padID];
+        float mx = pad->pos.x - chr->prop->pos.x;
+        float mz = pad->pos.z - chr->prop->pos.z;
+        float travel = sqrtf(mx * mx + mz * mz);
+        float px = pad->pos.x - target->prop->pos.x;
+        float pz = pad->pos.z - target->prop->pos.z;
+        float newRange = sqrtf(px * px + pz * pz);
+        float lateral = (tx * mz - tz * mx) / (range + 1.0f);
+        if (travel < 135.0f || travel > 650.0f ||
+            fabsf(pad->pos.y - target->prop->pos.y) > 150.0f) continue;
+        float score;
+        if (mode == MP_SIM_COMBAT_RETREAT) {
+            if (newRange < range + 70.0f) continue;
+            score = travel * 0.45f - (newRange - range);
+        } else {
+            if (fabsf(lateral) < 90.0f ||
+                newRange < route->combatIdealRange * 0.55f ||
+                newRange > route->combatIdealRange * 1.65f) continue;
+            score = fabsf(newRange - route->combatIdealRange) * 1.5f +
+                    travel * 0.4f - fabsf(lateral) * 0.35f +
+                    (lateral * (route->combatSide ? -1.0f : 1.0f) < 0.0f
+                     ? 130.0f : 0.0f);
+        }
+        if (score < best) { best = score; bestGoal = i; }
+    }
+    if (bestGoal >= 0 && bestGoal == route->combatGoal &&
+        chr->actiontype == ACT_GOPOS) return 1;
+    if (bestGoal >= 0 && chrGoToPad(chr, s_navWaypoints[bestGoal].padID,
+                                     SPEED_SPRINT)) {
+        route->combatGoal = bestGoal;
+        route->goal = -1;
+        route->combatSide ^= mode == MP_SIM_COMBAT_ORBIT;
+        sysLogPrintf(LOG_NOTE, "sim probe: combat mode %d to pad %d",
+                     mode, s_navWaypoints[bestGoal].padID);
+        return 1;
+    }
+    if (bestGoal >= 0) {
+        route->blockedGoal = bestGoal;
+        route->blockedUntil = polls + 240;
+    }
+    /* No traversable lateral pad: native standing turn still lets a cornered
+     * actor fight. Reconsider after the short replan interval. */
+    float desired = atan2f(tx, tz);
+    if (desired < 0.0f) desired += M_TAU_F;
+    int facing = (int)(desired * (M_U16_MAX_VALUE_F / M_TAU_F));
+    if (chr->actiontype != ACT_STAND)
+        check_set_actor_standing_still(chr, 0x10, facing);
+    else {
+        chr->act_stand.face_entitytype = 0x10;
+        chr->act_stand.face_entityid = facing;
+    }
+    route->combatGoal = -1;
+    return 1;
 }
 
