+/* A remote mine needs separation before it is safe to trigger. Choose a
+ * reachable native waypoint outside the blast margin rather than continuing
+ * pursuit into the planted mine. Normal pickup/combat goals resume as soon as
+ * the character is clear. */
+static int simProbeRetreatFromMine(ChrRecord *chr, unsigned polls,
+                                   SimProbeRoute *route)
+{
+    ObjectRecord *mine = route->mineObj;
+    waypoint *start;
+    int goal = -1;
+    float best = 1.0e30f;
+    if (!mine || !mpSimEffectOwned(mine, MP_SIM_EFFECT_REMOTE_MINE) ||
+        !mine->prop || ((WeaponObjRecord *)mine)->timer != 1 ||
+        ((mine->runtime_bitflags & RUNTIMEBITFLAG_HASPROJECTILE) &&
+         (mine->projectile->flags & PROJECTILEFLAG_AIRBORNE))) return 0;
+    float bx = chr->prop->pos.x - mine->runtime_pos.x;
+    float bz = chr->prop->pos.z - mine->runtime_pos.z;
+    if (bx * bx + bz * bz >= 330.0f * 330.0f) return 0;
+    if (polls < route->retreatRetryAfter) return chr->actiontype == ACT_GOPOS;
+    route->retreatRetryAfter = polls + SIM_ROUTE_REPLAN_POLLS;
+    start = chrlvStanPathRelated(&chr->prop->pos, chr->prop->stan);
+    if (!start) return 0;
+    for (int i = 0; i < s_navCount; ++i) {
+        PadRecord *pad = &g_CurrentSetup.pads[s_navWaypoints[i].padID];
+        float mx = pad->pos.x - mine->runtime_pos.x;
+        float mz = pad->pos.z - mine->runtime_pos.z;
+        float dx = pad->pos.x - chr->prop->pos.x;
+        float dz = pad->pos.z - chr->prop->pos.z;
+        if (&s_navWaypoints[i] == start ||
+            mx * mx + mz * mz < 430.0f * 430.0f ||
+            (simulantProbeGeneratedNavActive() &&
+             !mpNavGraphReachable(&s_generatedGraph, start->padID,
+                                  s_navWaypoints[i].padID))) continue;
+        float distance = dx * dx + dz * dz;
+        if (distance < best) { best = distance; goal = i; }
+    }
+    if (goal < 0 || !chrGoToPad(chr, s_navWaypoints[goal].padID,
+                                SPEED_SPRINT)) return 0;
+    route->goal = -1;
+    route->engaging = 0;
+    sysLogPrintf(LOG_NOTE, "sim probe: retreating from armed remote mine to pad %d",
+                 s_navWaypoints[goal].padID);
+    return 1;
 }
 
