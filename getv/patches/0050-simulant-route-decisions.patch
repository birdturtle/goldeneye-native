+/* Facility's authored links and generated links feed the same route metric.
+ * PD uses nearby waypoint attachment and path cost in bot navigation
+ * (n64decomp/perfect_dark @ 169ed48bdcbfb3b568b028bd5bebb27680073514,
+ * src/game/padhalllv.c and src/game/botcmd.c, MIT). These adapters use GE's
+ * live stage links and preserve its collision and door movement executor. */
+static int simProbeAuthoredLink(const MpNavAnchor *from,
+                                const MpNavAnchor *to, void *context)
+{
+    waypoint *points = context;
+    int i;
+    for (i = 0; i < s_navCount && points[i].padID != from->pad_id; ++i) {}
+    if (i == s_navCount || !points[i].neighbours) return 0;
+    for (s32 *n = points[i].neighbours; *n >= 0; ++n)
+        if (*n < s_navCount && points[*n].padID == to->pad_id) return 1;
+    return 0;
+}
+
+static const MpNavGraph *simProbeDecisionGraph(void)
+{
+    return simulantProbeGeneratedNavActive() ? &s_generatedGraph : &s_authoredGraph;
+}
+
+static int simProbeNavCosts(ChrRecord *chr, unsigned polls)
+{
+    const MpNavGraph *graph = simProbeDecisionGraph();
+    waypoint *start;
+    if (!graph->node_count || !s_navCosts || !chr->prop || !chr->prop->stan)
+        return 0;
+    start = chrlvStanPathRelated(&chr->prop->pos, chr->prop->stan);
+    if (!start) return 0;
+    if (s_navCostsStart != start->padID || polls - s_navCostsAt >= 30) {
+        if (!mpNavGraphCosts(graph, start->padID, s_navCosts,
+                              graph->node_count)) return 0;
+        s_navCostsStart = start->padID;
+        s_navCostsAt = polls;
+    }
+    return 1;
+}
+
+static float simProbeTravelCost(ChrRecord *chr, coord3d *pos, StandTile *stan)
+{
+    waypoint *end;
+    float path, sx, sy, sz, ex, ey, ez;
+    if (!stan || !s_navCosts || s_navCostsStart < 0) return -1.0f;
+    end = chrlvStanPathRelated(pos, stan);
+    if (!end) return -1.0f;
+    path = mpNavGraphCostToPad(simProbeDecisionGraph(), s_navCosts, end->padID);
+    if (path < 0.0f) return -1.0f;
+    PadRecord *startPad = &g_CurrentSetup.pads[s_navCostsStart];
+    PadRecord *endPad = &g_CurrentSetup.pads[end->padID];
+    sx = chr->prop->pos.x - startPad->pos.x;
+    sy = chr->prop->pos.y - startPad->pos.y;
+    sz = chr->prop->pos.z - startPad->pos.z;
+    ex = pos->x - endPad->pos.x;
+    ey = pos->y - endPad->pos.y;
+    ez = pos->z - endPad->pos.z;
+    return path + sqrtf(sx*sx + sz*sz + 16.0f*sy*sy) +
+           sqrtf(ex*ex + ez*ez + 16.0f*ey*ey);
+}
