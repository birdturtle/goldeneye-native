 //********************************************************************************************************
 //FILE SELECT
 //********************************************************************************************************
+#ifdef GE_PORT_NATIVE
+/* The original caller placed xmax/xmin and ymax/ymin in separate locals and
+ * passed &xmin and &ymin as coord2d pointers. That depended on the N64 stack
+ * layout: a native compiler can put the other float anywhere. Keep the same
+ * model extents and projection, with actual pairs for the two input corners. */
+static s32 frontCursorOnFolder(Model *folder, struct coord3d *position,
+                               f32 cursorX, f32 cursorY)
+{
+    f32 xmax, xmin, ymax, ymin;
+    struct coord2d xlimits, ylimits, projectedRightDown, projectedLeftUp;
+    f32 left, right, top, bottom;
+
+    modelGetXYExtents(folder, &xmax, &xmin, &ymax, &ymin);
+    xlimits.f[0] = xmin;
+    xlimits.f[1] = xmax;
+    ylimits.f[0] = ymin;
+    ylimits.f[1] = ymax;
+    projectRectCornersTo2D(position, &xlimits, &ylimits,
+                           &projectedRightDown, &projectedLeftUp);
+
+    left = projectedRightDown.f[0] < projectedLeftUp.f[0]
+        ? projectedRightDown.f[0] : projectedLeftUp.f[0];
+    right = projectedRightDown.f[0] > projectedLeftUp.f[0]
+        ? projectedRightDown.f[0] : projectedLeftUp.f[0];
+    top = projectedRightDown.f[1] < projectedLeftUp.f[1]
+        ? projectedRightDown.f[1] : projectedLeftUp.f[1];
+    bottom = projectedRightDown.f[1] > projectedLeftUp.f[1]
+        ? projectedRightDown.f[1] : projectedLeftUp.f[1];
+    return left <= cursorX && cursorX <= right &&
+           top <= cursorY && cursorY <= bottom;
+}
+#endif
